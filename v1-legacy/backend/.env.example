# ============================================================
# cleaners · variables de entorno de las Edge Functions (Stripe Connect)
# Se cargan en Supabase con:  supabase secrets set --env-file ./backend/.env
# NUNCA committear el .env real. Solo claves de TEST hasta validar.
# ============================================================

# Stripe (Dashboard → Developers → API keys). Empezar SIEMPRE con sk_test_...
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret (Dashboard → Developers → Webhooks → tu endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Supabase (Project Settings → API). La service_role es SECRETA (bypassa RLS).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...REPLACE_ME

# URL pública del sitio (para CORS + redirect de Checkout)
SITE_URL=https://getcleaners.nl
